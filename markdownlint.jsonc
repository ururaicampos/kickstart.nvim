// Default markdownlint rules for nvim-lint; a .markdownlint.* in the project still wins.
{
  "MD010": { "code_blocks": false }, // tabs are fine inside code blocks (Go, Makefiles)
  "MD013": false, // no line-length limit
  "MD022": false, // blank lines around headings
  "MD024": { "siblings_only": true }, // repeated headings only flagged under the same parent
  "MD031": false, // blank lines around code fences
  "MD032": false, // blank lines around lists
  "MD033": false, // inline HTML allowed
  "MD041": false, // first line need not be a heading
  "MD060": false // table column style
}
